# Copy to .env for local (non-docker-compose) runs, e.g. `go run ./cmd/ingestion-api`
# against a docker-compose-provided Kafka/Postgres/Redis.

SERVICE_NAME=ingestion-api
HTTP_ADDR=:8080
LOG_LEVEL=info

KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=behavior.events
KAFKA_GROUP_ID=profile-consumer

POSTGRES_DSN=postgres://behavior:behavior@localhost:5432/behavior_engine?sslmode=disable
REDIS_ADDR=localhost:6379
REDIS_DB=0

PROFILE_CACHE_TTL=24h
ACTIVE_EXPERIMENT_ID=checkout_button_color
